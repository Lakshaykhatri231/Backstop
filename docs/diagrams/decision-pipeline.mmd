%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','lineColor':'#475569'},'flowchart':{'nodeSpacing':20,'rankSpacing':22,'padding':8,'htmlLabels':true}}}%%
flowchart TD
    LEAK(["Revenue leak"])
    SRC{"Which source<br/>detected it?"}
    W["Payment webhook"]
    POLL["Background poller"]
    CE["CartEvent row created"]
    EV1["Event + Decision row<br/>told to us by Razorpay"]
    EV2["Event + Decision row<br/>built from order state"]
    RULES["Rules engine picks action,<br/>confidence, reasoning"]
    LLM["LLM (Groq, 8 s timeout)"]
    OK{"LLM call<br/>succeeds?"}
    GATE{"Confidence above<br/>the threshold?"}
    EXEC["execute_action()"]
    ESC["Forced to<br/>escalate_to_human"]
    AUD["Audited"]
    CR["Rules engine picks action<br/>(deterministic)"]
    NL["No LLM layer"]
    NG["No gate"]
    AUD2["Audited"]
    LEAK --> SRC
    SRC --> L1(["payment failure"])
    L1 --> W
    SRC --> L2(["checkout stuck"])
    L2 --> POLL
    SRC --> L3(["cart event"])
    L3 --> CE
    W --> EV1
    POLL --> EV2
    EV1 --> RULES
    EV2 --> RULES
    RULES --> LLM
    LLM --> OK
    OK --> L4(["no: keep rules' pick"])
    L4 --> GATE
    OK --> L5(["yes"])
    L5 --> GATE
    GATE --> L6(["yes, or exempt"])
    L6 --> EXEC
    GATE --> L7(["no"])
    L7 --> ESC
    ESC --> EXEC
    EXEC --> AUD
    CE --> CR
    CR --> NL
    NL --> NG
    NG --> AUD2

    classDef start fill:#e2e8f0,stroke:#475569,color:#0f172a
    classDef head fill:#1e1b4b,stroke:#1e1b4b,color:#ffffff
    classDef step fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef cart fill:#ccfbf1,stroke:#0d9488,color:#134e4a
    classDef ask fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef ai fill:#f3e8ff,stroke:#9333ea,color:#3b0764
    classDef good fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef bad fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef person fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    classDef log fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef tag fill:#ffffff,stroke:#94a3b8,color:#334155,font-size:12px
    class LEAK start
    class W,POLL,EV1,EV2,RULES,EXEC step
    class CE,CR,NL,NG cart
    class SRC,OK,GATE ask
    class LLM ai
    class ESC person
    class AUD,AUD2 log
    class L1,L2,L3,L4,L5,L6,L7 tag
