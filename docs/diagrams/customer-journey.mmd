%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','edgeLabelBackground':'#ffffff','lineColor':'#475569'},'flowchart':{'nodeSpacing':22,'rankSpacing':26,'padding':8,'htmlLabels':true}}}%%
flowchart TD
    START(["Customer logs in"]) --> CART["Adds items to cart"]
    CART --> FORK{"What happens<br/>to the cart?"}
    FORK -- times out --> TH(["TIMEOUT"])
    FORK -- cancels --> CH(["CANCELLED"])
    FORK -- pays --> PH(["PAYMENT INITIATED"])

    TH --> T1["Silent abandon recorded"]
    T1 --> T2["Nudge or tier discount<br/>(if tier is eligible)"]
    T2 --> T3{"Resumes<br/>in time?"}
    T3 -- yes --> TR(["Recovered"])
    T3 -- expires --> TL(["Lost"])

    CH --> C1["Explicit cancel<br/>cart snapshot saved"]
    C1 --> C2{"3rd or later<br/>cancel?"}
    C2 -- yes --> CE(["Escalated"])
    C2 -- no --> C3{"Tier<br/>eligible?"}
    C3 -- "NEW / RISK" --> CL1(["Lost"])
    C3 -- eligible --> C4["Snapshot resurfaces on<br/>every /cart visit"]
    C4 --> C5{"Acts before<br/>expiry?"}
    C5 -- resumes --> CR(["Recovered"])
    C5 -- declines --> CL2(["Lost"])

    PH --> P1["Order created,<br/>payment attempted"]
    P1 --> P2{"Gateway<br/>result?"}
    P2 -- captured --> PR(["Recovered"])
    P2 -- fails --> P3["Rules engine picks<br/>the next action"]
    P3 --> P4{"Next<br/>action?"}
    P4 -- "retry" --> P1
    P4 -- exhausted --> PE(["Escalated"])
    P4 -- "gives up" --> PL(["Lost"])

    TH ~~~ CH
    CH ~~~ PH

    classDef start fill:#e2e8f0,stroke:#475569,color:#0f172a
    classDef head fill:#1e1b4b,stroke:#1e1b4b,color:#ffffff
    classDef step fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef ask fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef good fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef bad fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef person fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    class START start
    class TH,CH,PH head
    class CART,T1,T2,C1,C4,P1,P3 step
    class FORK,T3,C2,C3,C5,P2,P4 ask
    class TR,CR,PR good
    class TL,CL1,CL2,PL bad
    class CE,PE person
