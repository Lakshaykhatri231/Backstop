# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_dashboard
# Payment Links: auto (real when keys are set) | real | stub (labelled stand-ins, nothing reaches Razorpay).
# Test Mode allows ~30 links per business; at the cap the app sends labelled stand-ins and audits it.
RAZORPAY_LINKS=auto
RAZORPAY_TEST_LINK_CAP=30

# --- LLM decision agent (Groq - free tier, no credit card) ---
# Sign up at console.groq.com to get a key.
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_recovery

# --- Agent thresholds ---
CONFIDENCE_THRESHOLD=0.70
HIGH_VALUE_AMOUNT_INR=5000
MAX_AUTO_RETRIES=3

# --- Checkout drop-off poller (see app/dropoff.py) ---
DROPOFF_POLL_INTERVAL_MINUTES=10
DROPOFF_ABANDONMENT_WINDOW_MINUTES=10
DROPOFF_LOOKBACK_DAYS=7

# --- Signs customer session tokens for the storefront - change this
# before deploying anywhere it needs to be real ---
STOREFRONT_SECRET_KEY=dev-only-change-me

# --- Per-tier incentive amount caps (see app/config.py for the full set
# of per-tier knobs: discount bands, 30d frequency caps, tier thresholds) ---
INCENTIVE_MAX_ORDER_VALUE_CASUAL=2000
INCENTIVE_MAX_ORDER_VALUE_REGULAR=3000
INCENTIVE_MAX_ORDER_VALUE_LOYAL=4000

# --- Environment + access ---
# "production" refuses the simulated OTP / messaging / voice / DND providers and refuses
# to start with the default STOREFRONT_SECRET_KEY, an empty MERCHANT_API_KEY
# or an empty RAZORPAY_WEBHOOK_SECRET.
ENVIRONMENT=development
# Leave empty for the open demo dashboard. Set a long random value to require
# an X-Merchant-Key header on every merchant-side endpoint (the dashboard
# asks for it once).
MERCHANT_API_KEY=
# Simulated DND registry for testing the block: comma-separated numbers.
DND_SIMULATED_NUMBERS=

# --- SMS / OTP providers (app/messaging.py, app/otp.py) ---
# "simulated" stores every message (Demo Console inbox) and delivers nothing.
# "msg91" sends through MSG91; needs DLT-approved templates. Leave blank to
# stay simulated. Never paste these values into a chat or commit them.
OTP_PROVIDER=simulated
MESSAGING_PROVIDER=simulated
PUBLIC_BASE_URL=http://localhost:8000
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_TPL_PRE_DEBIT_NOTICE=
MSG91_TPL_PAYMENT_LINK=
MSG91_TPL_REMANDATE_LINK=
MSG91_TPL_PROMISE_REMINDER=
MSG91_TPL_INVOICE_COURTESY=
MSG91_TPL_INVOICE_OVERDUE=
# Only read by scripts/live_check.py: your OWN mobile for the one live test.
YOUR_TEST_MOBILE=

# --- Demo / failure injection ---
# Set to true to force the LLM call to fail, so you can demo the
# graceful-fallback path on demand.
SIMULATE_LLM_FAILURE=false

# --- Demo Console speech (optional; browser voice/ear are used when unset) ---
# Voice: Azure AI Speech, free F0 tier (Azure for Students needs no card).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# Listening: Groq-hosted Whisper reuses GROQ_API_KEY.
# VOICE_TTS_PROVIDER=auto   # auto | browser | azure
# VOICE_STT_PROVIDER=auto   # auto | browser | groq

# --- Live call agent: retrieval, memory, persona, hands-free (all optional; sensible defaults) ---
# RAG_ENABLED=true                 # merchant knowledge + customer memory; embeddings run locally (no key)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RETRIEVAL_MIN_SCORE=0.22         # cosine floor for showing a passage to the model
# RETRIEVAL_MIN_OVERLAP=0.15       # ...which must also share this share of its words with the question, or
# RETRIEVAL_CONFIDENT_SCORE=0.40   # ...score at least this (together they reject most off-topic questions)
# MEMORY_RETENTION_DAYS=180        # episodes, word-for-word chunks and facts expire (only kept with the customer's consent)
# MEMORY_CHUNK_TURNS=4             # turns per word-for-word window
# MEMORY_BUDGET_CHARS=2000         # most remembered text handed to the model in one turn
# MEMORY_HALF_LIFE_DAYS=60         # recall weight halves every this many days
# MEMORY_TOP_K=3                   # word-for-word windows returned on a recall question
# PERSONA_GENDER=female            # matches the Azure voices; male flips the fixed lines
# STT_LANGUAGE_MODE=fixed          # fixed | auto  (see scripts/eval_stt.py; fixed won on our samples)
# TTS_CACHE_DIR=var/tts_cache      # synthesized lines are cached (saves the free Azure allowance)

# ── Logins ──
# The one merchant account, created on first start when both are set. Once it exists the dashboard and
# Demo Console require that sign-in (MERCHANT_API_KEY, if set, still works too). Min 8 characters.
MERCHANT_EMAIL=
MERCHANT_PASSWORD=
# Demo Console only: how far ahead of "now" a REAL Razorpay step may sit before the console warns (a rule of
# thumb, not a documented Razorpay limit).
TEST_MODE_WINDOW_DAYS=3
