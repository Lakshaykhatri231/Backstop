# TIER_BEHAVIOR_WINDOW_DAYS=180
# TIER_RISK_MIN_ATTEMPTS=2
# TIER_RISK_ATTRIBUTABLE_FAILURE_RATE=0.6
# TIER_RISK_CANCEL_RATE=0.6
# TIER_REFRESH_INTERVAL_MINUTES=30
# STALE_ORDER_ABANDON_AFTER_HOURS=24

# --- Autopay retries, promises, receivables chase, collections analysis ---
# MANDATE_MAX_RETRIES=4
# MANDATE_RETRY_WINDOW_DAYS=10
# RECEIVABLES_CHASE_OFFSETS_DAYS=-3,1,7,15
# RECEIVABLES_ESCALATE_AFTER_DAYS=30
# COLLECTIONS_MIN_SAMPLE=20
# PROMISE_MAX_DAYS_B2C=7
# PROMISE_MAX_DAYS_B2B=30
# PROMISE_MAX_BROKEN=2
# PROMISE_GRACE_DAYS=1
# SCHEDULER_INTERVAL_SECONDS=60

# --- Voice agent limits and Azure voices ---
# AZURE_VOICE_HI=en-IN-Meera:DragonHDLatestNeural
# AZURE_VOICE_EN=en-IN-Meera:DragonHDLatestNeural
# AZURE_VOICE_HINGLISH=en-IN-Meera:DragonHDLatestNeural
# AZURE_VOICE_FALLBACK=en-IN-NeerjaNeural
# AZURE_HD_DELIVERY=true                    # gentle / brief customers get a slower / quicker pace and extra pauses on a Dragon HD voice
# GROQ_STT_MODEL=whisper-large-v3
# VOICE_MIN_ORDER_VALUE=1000
# VOICE_FAILED_ORDER_WAIT_HOURS=4
# VOICE_MAX_ATTEMPTS_PER_SUBJECT=3

# --- OTP limits and extra MSG91 templates ---
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
# MSG91_TPL_PAYMENT_LINK_OFFER=
# MSG91_TPL_ORDER_OFFER_ENDED=

# --- Misc ---
# MERCHANT_NAME=Backstop Store
# DND_PROVIDER=simulated
# EMBEDDING_DIM=384
# DEFAULT_MERCHANT_ID=default
